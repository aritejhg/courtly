# Copy to .env (git-ignored). Everything here is optional for local UI work: with
# nothing set, the dev server shows invented sample listings and hides Telegram links.

# Browser, read at build time. Set as GitHub Actions secrets for the deploy workflow.
# Invite link behind the "Telegram group" header button.
VITE_COURTLY_TELEGRAM_SOURCE_URL=
# Chat ID used for exact message links (with or without the -100 prefix).
VITE_COURTLY_TELEGRAM_CHAT_ID=

# Ingestion host only. Telegram ingestion refuses to run without both.
COURTLY_TELEGRAM_SOURCE_URL=
COURTLY_TELEGRAM_CHAT_ID=
