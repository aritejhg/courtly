# Copy to .env (git-ignored). Everything here is optional for local UI work: with
# nothing set, the dev server shows invented sample listings and hides the Telegram group and message links.
# README.md lists every variable.

# Browser, read at build time and embedded in client JavaScript, so public once
# deployed. Never give Telegram values a VITE_ prefix.
# Optional OneMap token for public transport routing. Without it, times are estimates.
VITE_ONEMAP_TOKEN=
# Optional Cloudflare Web Analytics token. Without it, the beacon is not loaded.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=

# Telegram source. Ingestion refuses to run without both. The app reads the same names
# at runtime and serves them only behind the access gate. In production they are Worker
# secrets, set with `wrangler secret put`. The dev server reads them from here. Without
# them, the group and message links are hidden.
COURTLY_TELEGRAM_SOURCE_URL=
COURTLY_TELEGRAM_CHAT_ID=
